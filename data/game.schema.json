{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "versionGroup": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "pokedex": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      ]
    },
    "sprites": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\/[a-z0-9-]+)+$"
    },
    "starters": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "exclusiveGroups": {
      "default": [],
      "type": "array",
      "items": {
        "minItems": 2,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        }
      }
    },
    "locations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9-]+(\\/[a-z0-9-]+)?(@[a-z0-9-]+)?$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "string",
            "const": "postgame"
          },
          {
            "type": "string",
            "const": "excluded"
          }
        ]
      }
    },
    "methods": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "trades": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "place": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "encounterConditions": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9*-]+$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "string",
            "const": "postgame"
          },
          {
            "type": "string",
            "const": "excluded"
          }
        ]
      }
    },
    "items": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "string",
            "const": "postgame"
          }
        ]
      }
    },
    "hms": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "string",
            "const": "postgame"
          }
        ]
      }
    },
    "moves": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "string",
            "const": "postgame"
          }
        ]
      }
    },
    "conditions": {
      "default": {},
      "type": "object",
      "properties": {
        "beauty": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "const": "postgame"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "battles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "postgame": {
            "default": false,
            "type": "boolean"
          },
          "party": {
            "minItems": 1,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "species": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "moves": {
                  "minItems": 1,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                  }
                }
              },
              "required": [
                "species",
                "level",
                "moves"
              ],
              "additionalProperties": false
            }
          },
          "partyByStarter": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "additionalProperties": {
              "minItems": 1,
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "species": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "moves": {
                    "minItems": 1,
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    }
                  }
                },
                "required": [
                  "species",
                  "level",
                  "moves"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "required": [
          "id",
          "name",
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "versionGroup",
    "pokedex",
    "sprites",
    "starters",
    "locations",
    "battles"
  ],
  "additionalProperties": false
}
